{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevOps Station",
  "version": "0.1.11",
  "identifier": "dev.hones.devops-station",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevOps Station",
        "width": 1440,
        "height": 900,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--allow-running-insecure-content --disable-features=BlockInsecurePrivateNetworkRequests"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzRTkyRjM1Q0VDMDFFQzIKUldUQ0hzRE9OUy9wczRaRnNvQ2NLWXUvdDdoblJEZndSOHdLbE1UeEFYSXVEdGRVaTc1cWJ2bHcK",
      "endpoints": [
        "https://github.com/HonestLiu/Devops-Station/releases/latest/download/latest.json"
      ]
    }
  }
}
